@page "/"
@rendermode InteractiveServer
@using HangarDashboard.Models
@using HangarDashboard.Services
@using static HangarDashboard.Services.InvariantFormat
@inject HangarApiClient Api

<PageTitle>Hangar Layout Planner</PageTitle>

<h1>Hangar Layout Planner</h1>
<p>
    Consumes the Python (FastAPI) <code>hangar_cv_optimizer</code> backend's
    <code>/optimize-layout</code> endpoint - this Blazor app does not
    re-implement any positioning or collision logic itself.
</p>

<div class="row">
    <div class="col-md-4">
        <h4>Hangar</h4>
        <div class="mb-2">
            <label>Width (m)</label>
            <InputNumber class="form-control" @bind-Value="hangarWidth" />
        </div>
        <div class="mb-2">
            <label>Height (m)</label>
            <InputNumber class="form-control" @bind-Value="hangarHeight" />
        </div>
        <div class="mb-2">
            <label>Clearance (m)</label>
            <InputNumber class="form-control" @bind-Value="clearanceM" />
        </div>

        <h4 class="mt-4">Aircraft</h4>
        @foreach (var (aircraft, index) in aircraftRows.Select((a, i) => (a, i)))
        {
            <div class="row g-1 mb-1 align-items-center">
                <div class="col-3"><input class="form-control form-control-sm" @bind="aircraft.Id" placeholder="id" /></div>
                <div class="col-3"><input type="number" class="form-control form-control-sm" @bind="aircraft.WingspanM" placeholder="wingspan m" /></div>
                <div class="col-3"><input type="number" class="form-control form-control-sm" @bind="aircraft.LengthM" placeholder="length m" /></div>
                <div class="col-3">
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => aircraftRows.RemoveAt(index)">x</button>
                </div>
            </div>
        }
        <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="AddAircraftRow">+ Add aircraft</button>

        <div class="mt-4">
            <button class="btn btn-primary" @onclick="RunOptimize" disabled="@isLoading">
                @(isLoading ? "Optimizing..." : "Optimize Layout")
            </button>
        </div>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </div>

    <div class="col-md-8">
        <h4>Result</h4>
        @if (result is not null)
        {
            <p>
                Placed: <strong>@result.Result.Placed.Count</strong> /
                @(result.Result.Placed.Count + result.Result.UnplacedIds.Count)
                &nbsp;|&nbsp; Utilization: <strong>@((result.Result.Utilization * 100).ToString("0.0"))%</strong>
                &nbsp;|&nbsp;
                Collision status:
                @if (result.CollisionReport.IsClear)
                {
                    <span class="badge bg-success">clear</span>
                }
                else
                {
                    <span class="badge bg-danger">@result.CollisionReport.Violations.Count violation(s)</span>
                }
            </p>

            @if (result.Result.UnplacedIds.Count > 0)
            {
                <p class="text-warning">Unplaced: @string.Join(", ", result.Result.UnplacedIds)</p>
            }

            <div class="border" style="width: 100%; max-width: 700px;">
                <svg viewBox="@($"0 0 {hangarWidth.Inv()} {hangarHeight.Inv()}")" style="width: 100%; background: #f5f5f5;">
                    <rect x="0" y="0" width="@hangarWidth.Inv()" height="@hangarHeight.Inv()" fill="none" stroke="black" stroke-width="0.3" />

                    @foreach (var aircraft in result.Result.Placed)
                    {
                        var isInViolation = result.CollisionReport.Violations.Any(v => v.AircraftIds.Contains(aircraft.Id));
                        var color = isInViolation ? "#e74c3c" : "#3498db";
                        var halfLength = aircraft.LengthM / 2;
                        var halfWingspan = aircraft.WingspanM / 2;
                        var transform = $"translate({aircraft.Center.X.Inv()}, {aircraft.Center.Y.Inv()}) rotate({aircraft.RotationDeg.Inv()})";

                        <g transform="@transform">
                            <rect x="@((-halfLength).Inv())"
                                  y="@((-halfWingspan).Inv())"
                                  width="@aircraft.LengthM.Inv()" height="@aircraft.WingspanM.Inv()"
                                  fill="@color" fill-opacity="0.7" stroke="black" stroke-width="0.15" />
                        </g>
                        @RenderAircraftLabel(aircraft)
                    }
                </svg>
            </div>
        }
        else
        {
            <p class="text-muted">Run the optimizer to see a layout here.</p>
        }
    </div>
</div>

@code {
    private double hangarWidth = 80;
    private double hangarHeight = 60;
    private double clearanceM = 3.0;
    private bool isLoading;
    private string? errorMessage;
    private OptimizeLayoutResponse? result;

    private List<AircraftRow> aircraftRows = new()
    {
        new AircraftRow { Id = "a1", WingspanM = 8, LengthM = 10 },
        new AircraftRow { Id = "a2", WingspanM = 8, LengthM = 10 },
        new AircraftRow { Id = "a3", WingspanM = 12, LengthM = 15 },
    };

    private void AddAircraftRow()
    {
        aircraftRows.Add(new AircraftRow { Id = $"a{aircraftRows.Count + 1}", WingspanM = 8, LengthM = 10 });
    }

    private async Task RunOptimize()
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            var hangar = new HangarBoundary(
                new List<Point>
                {
                    new(0, 0),
                    new(hangarWidth, 0),
                    new(hangarWidth, hangarHeight),
                    new(0, hangarHeight),
                },
                new List<List<Point>>()
            );

            var aircraft = aircraftRows
                .Select(a => new PlaceableAircraft(a.Id, "", a.WingspanM, a.LengthM))
                .ToList();

            var request = new OptimizeLayoutRequest(hangar, aircraft, clearanceM, 2.0, 150, 42);
            result = await Api.OptimizeLayoutAsync(request);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to reach backend: {ex.Message}. Is the FastAPI server running?";
        }
        finally
        {
            isLoading = false;
        }
    }

    // SVG <text> collides with Razor's own reserved <text> markup tag, so it
    // can't be written directly in the .razor markup - emit it as raw HTML instead.
    private MarkupString RenderAircraftLabel(AircraftFootprint aircraft)
    {
        var x = aircraft.Center.X.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var y = aircraft.Center.Y.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var label = System.Net.WebUtility.HtmlEncode(aircraft.Id);
        return new MarkupString(
            $"<text x=\"{x}\" y=\"{y}\" font-size=\"1.5\" text-anchor=\"middle\" fill=\"white\">{label}</text>"
        );
    }

    private class AircraftRow
    {
        public string Id { get; set; } = "";
        public double WingspanM { get; set; }
        public double LengthM { get; set; }
    }
}
